# Environment variables file
# Copy this file to .env dan isi dengan nilai yang sesuai

# Flask configuration
SECRET_KEY=your-secret-key-change-this-in-production
FLASK_ENV=development

# Server configuration untuk production
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database configuration
# SQLite (default untuk development)
#DATABASE_URL=sqlite:///sapapi.db

# PostgreSQL example
DATABASE_URL=postgresql://postgres:admin@localhost:5432/sapdwh

# SQL Server example  
# DATABASE_URL=mssql+pyodbc://username:password@server:1433/database?driver=ODBC+Driver+17+for+SQL+Server

# MySQL example
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/sapapi

# Logging
LOG_LEVEL=INFO

# API Configuration
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000