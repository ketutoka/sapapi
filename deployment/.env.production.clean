# Production Environment Configuration
# This file will be loaded by the systemd service
# Place this file at: /opt/sapapi/.env

# Flask Environment (critical - also set in systemd for redundancy)
FLASK_ENV=production
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL)
# IMPORTANT: Change the password before deployment!
DATABASE_URL=postgresql://sapapi_user:CHANGE_THIS_PASSWORD@localhost:5432/sapdwh

# Security Configuration
# IMPORTANT: Generate a strong secret key for production!
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION

# Logging Configuration
LOG_LEVEL=INFO

# API Configuration
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# Database Connection Pool Settings
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=20
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_MAX_OVERFLOW=20

# Security Headers
SECURITY_HEADERS_ENABLED=true

# CORS Settings (adjust as needed for your domain)
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With

# Performance Tuning
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=2

# Monitoring and Health Check
HEALTH_CHECK_TIMEOUT=10
API_REQUEST_TIMEOUT=30